{
  "ci": {
    "collect": {
      "startServerCommand": "node ../protect/preview.mjs --site ../../exampleSite --no-build --port 47174",
      "startServerReadyPattern": "Open http",
      "url": [
        "http://127.0.0.1:47174/",
        "http://127.0.0.1:47174/posts/images-and-galleries/",
        "http://127.0.0.1:47174/posts/code-and-diagrams/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox",
        "skipAudits": ["is-on-https", "redirects-http", "uses-http2"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse"
    }
  }
}
